# Secrets only — see docs/env-vs-config split in ARCHITECTURE.md
# Copy this file to .env and fill in your values.
# Non-secret configuration options are in config.example.yaml (copy to config.yaml).

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram numeric user ID for the admin/owner (for /stop, /pause_all, /s7_session, debug commands)
ADMIN_TG_ID=123456789

# Travelpayouts / Aviasales Data API token and affiliate marker
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
TRAVELPAYOUTS_MARKER=your_affiliate_marker_here

# Yandex.Rasp API key (optional: yandex_rasp_enabled is false by default because free keys lack prices)
YANDEX_RASP_API_KEY=your_yandex_rasp_api_key_here
