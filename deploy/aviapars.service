[Unit]
Description=Aviapars ticket price tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/aviapars
EnvironmentFile=/opt/aviapars/.env
ExecStart=/opt/aviapars/.venv/bin/python -m aviapars
Restart=on-failure
RestartSec=10

# MemoryMax has headroom above the ~230-330MB steady state for s7_direct's rare
# browser-solver fallback (ephemeral patchright/chromium subprocess, only spawned when
# the cheap cached-session path fails — see adapters/s7_direct.py, solver/). No cgroup
# isolation for that subprocess: it inherits this same slice. Acceptable because it's
# on-demand, not scheduled, and bounded by BrowserSolverClient's own timeout — a spike
# hitting MemoryMax just kills the solve attempt, s7_direct returns EMPTY, nothing else
# in the process is affected (never-raise adapter contract).
MemoryHigh=450M
MemoryMax=900M
CPUWeight=50
Nice=5
WatchdogSec=300
TimeoutStopSec=30

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/aviapars

User=aviapars
Group=aviapars

[Install]
WantedBy=multi-user.target
